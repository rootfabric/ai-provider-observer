# Common
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12
DATABASE_PATH=./data/observer.db
DEMO_MODE=false

# Z.AI Coding Plan
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai

# MiniMax Token/Coding Plan (global)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://www.minimax.io

# DeepSeek pay-as-you-go
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter
OPENROUTER_API_KEY=
# Optional. Needed only for account-wide purchased/used credits via /api/v1/credits.
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai

# OpenAI Codex subscription usage.
# Normally leave these unset: the service reads the same local login as Codex CLI.
CODEX_HOME=
CODEX_AUTH_PATH=
CODEX_BASE_URL=https://chatgpt.com/backend-api

# R1 analytics surface
ANALYTICS_ENABLED=true            # master switch for the analytics layer
DEMO_SCENARIO=normal              # normal|high_burn|weekly_exhaustion|critical
PLANS_CONFIG_PATH=./config/plans.yaml
QUOTA_RETENTION_DAYS=0            # 0 = keep everything (MVP)
HISTORY_LOOKBACK_HOURS=200        # how far back the engine reads from quota_snapshots

# Alert thresholds (spec §24)
ALERT_WARNING_USED=70             # % used → WARNING
ALERT_HIGH_USED=85                # % used → HIGH
ALERT_CRITICAL_USED=95            # % used → CRITICAL
ALERT_WARNING_PROJECTED_WEEK=90   # projected weekly % → WARNING
ALERT_CRITICAL_PROJECTED_WEEK=120 # projected weekly % → CRITICAL
ALERT_CRITICAL_ETA_MINUTES=30     # ETA under this many minutes → CRITICAL
BALANCE_LOW_DAYS=7                # balance runway under N days → balance_low

# Analytics constants (tunable; defaults are reasonable for MVP)
BURN_MIN_POINTS=3                 # minimum points for a regression
BURN_MIN_SPAN_MINUTES=5           # minimum time span for a regression
RESET_DROP_MIN_PP=5               # drop in used_percent that counts as a reset
RESET_JITTER_PP=2                 # smaller drops are treated as API jitter
ACCEL_BASELINE_MIN=1.0            # |burn_1h| below this disables acceleration
WEEK_MIN_ELAPSED_PCT=3            # weekly pace is suppressed below this elapsed %
RECOMMENDED_HEADROOM_FACTOR=1.25  # extra headroom on top of required capacity
EVENT_COOLDOWN_MINUTES=30         # default cooldown between repeat alert events
